# =========================================================
# 线上环境变量模板
# =========================================================
# 用法：复制成 deploy/.env 后填入真实值
#       cp deploy/.env.example deploy/.env
# =========================================================

# ---------- 数据库 ----------
# Postgres 密码（自己改一个强密码）
DB_PASSWORD=nocodb_pass_2026

# ---------- NocoDB ----------
# NocoDB 的 API Token（和你本机 backend/.env 里的一致）
NOCODB_API_TOKEN=在这里填你的_NOCODB_API_TOKEN

# ---------- 加密密钥 ----------
# 必须与本机 backend/.env 里的完全一致，
# 否则前端加密后的报文后端解不开
PAYLOAD_ENC_KEY=在这里填_PAYLOAD_ENC_KEY
DATA_ENC_KEY=在这里填_DATA_ENC_KEY

# ---------- 公网访问 ----------
# 服务器公网地址（IP 或域名），附件签名链接要用
PUBLIC_BASE_URL=http://你的公网IP:8080

# ---------- 安全开关 ----------
# 有 HTTPS（配了域名证书）后改成 1，强制跳转 https
FORCE_HTTPS=0
# 前端域名（前后端同源部署时保持 *）
ALLOWED_ORIGIN=*
# 单 IP 每分钟请求上限
RATE_LIMIT_MAX=600
# 登录有效期（小时）
SESSION_TTL_HOURS=12
