#!/bin/bash
# ============================================================
# 磁县困难青少年精准帮扶管理系统 - 一键启动
#
# 用法：双击本文件即可。
#       （macOS 首次可能提示"无法打开"，
#         右键本文件 → 打开 → 确认即可）
# ============================================================

cd "$(dirname "$0")" || exit 1

echo ""
echo "============================================"
echo "  磁县困难青少年精准帮扶管理系统"
echo "============================================"
echo ""

# ---------- 1. 安装依赖（只在缺失时安装） ----------
if [ ! -d "node_modules" ]; then
  echo "[1/4] 首次运行，正在安装前端依赖（约 1-3 分钟）..."
  npm install || { echo "前端依赖安装失败"; read -p "按回车退出"; exit 1; }
else
  echo "[1/4] 前端依赖已存在，跳过"
fi

if [ ! -d "backend/node_modules" ]; then
  echo "[2/4] 首次运行，正在安装后端依赖..."
  (cd backend && npm install) || { echo "后端依赖安装失败"; read -p "按回车退出"; exit 1; }
else
  echo "[2/4] 后端依赖已存在，跳过"
fi

# ---------- 2. 启动后端 ----------
echo "[3/4] 正在启动后端服务（端口 3001）..."
(cd backend && nohup node server.js > backend.log 2>&1 &)
sleep 4

# ---------- 3. 启动前端 ----------
echo "[4/4] 正在启动前端服务..."
echo ""
echo "启动完成后，浏览器会自动打开。"
echo "前端地址一般是 http://localhost:5173/"
echo "（如果被占用会自动换端口，以窗口里显示的地址为准）"
echo ""
echo "关闭方法：回到这个窗口按 Control + C"
echo ""

sleep 3
open "http://localhost:5173/" 2>/dev/null

npm run dev
