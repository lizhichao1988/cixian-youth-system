# 后端环境变量示例（复制为 .env 后填入真实值）
#
# NocoDB 连接信息
NOCODB_BASE_URL=http://localhost:8080
NOCODB_BASE_ID=p0c8s7fcnd9d9d7
NOCODB_API_TOKEN=nc_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# 服务端口（部署平台通常会自动注入 PORT，本地默认 3001）
# PORT=3001

# 跨域：前后端分离时填前端域名，逗号分隔；单服务部署留空（放行全部）
# ALLOWED_ORIGIN=https://abc.vercel.app

# 迁移到 NocoDB Cloud / 其他实例后，表 ID 会变化，按需覆盖：
# NOCODB_TABLE_YOUTH=xxx
# NOCODB_TABLE_RISKS=xxx
# NOCODB_TABLE_CATEGORIES=xxx
# NOCODB_TABLE_HELP_NEEDS=xxx
# NOCODB_TABLE_PAIRINGS=xxx
# NOCODB_TABLE_HELP_RECORDS=xxx
# NOCODB_TABLE_ACCOUNTS=xxx
